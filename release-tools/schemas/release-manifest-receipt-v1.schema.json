{
  "$id": "https://github.com/Plantcore-AI/Iteron/release-tools/schemas/release-manifest-receipt-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "name": { "const": "release-manifest.json" },
        "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" },
        "size": { "maximum": 1048576, "minimum": 1, "type": "integer" }
      },
      "required": ["name", "sha256", "size"],
      "type": "object"
    },
    "schema_version": { "const": 1 },
    "tag": {
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "type": { "const": "release_manifest_receipt" }
  },
  "required": ["commit", "manifest", "schema_version", "tag", "type"],
  "title": "Iteron release manifest receipt v1",
  "type": "object"
}
