{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iteron.dev/contracts/plantcore/machine-contract.v1.schema.json",
  "title": "Iteron machine contract",
  "type": "object",
  "required": [
    "schema_version",
    "type",
    "contract_version",
    "release_id",
    "cli_stream_versions",
    "default_cli_stream_version",
    "resident_protocol_version",
    "canonical_json",
    "plantcore_capabilities",
    "limits",
    "contract_artifacts"
  ],
  "properties": {
    "schema_version": { "const": 3 },
    "type": { "const": "machine_contract" },
    "contract_version": { "const": "plantcore.iteron.machine-contract.v1" },
    "release_id": { "type": "string", "pattern": "^iteron-v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "cli_stream_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "default_cli_stream_version": { "type": "integer", "minimum": 1 },
    "resident_protocol_version": { "const": 4 },
    "canonical_json": {
      "type": "object",
      "required": ["version", "algorithm", "maximum_depth", "maximum_safe_integer", "rejects_duplicate_keys"],
      "properties": {
        "version": { "const": "plantcore.portable-canonical-json.v1" },
        "algorithm": { "const": "utf8-sorted-compact-integer-only-v1" },
        "maximum_depth": { "const": 32 },
        "maximum_safe_integer": { "const": 9007199254740991 },
        "rejects_duplicate_keys": { "const": true }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["machine_contract_max_bytes", "logical_v7_event_max_bytes"],
      "properties": {
        "machine_contract_max_bytes": { "const": 1048576 },
        "logical_v7_event_max_bytes": { "const": 65536 }
      },
      "additionalProperties": false
    },
    "contract_artifacts": {
      "type": "object",
      "required": ["machine_contract_schema", "app_server_v4_schema", "output_v7_target_schema", "workspace_hook_v1_schema"],
      "properties": {
        "machine_contract_schema": { "$ref": "#/$defs/artifact" },
        "app_server_v4_schema": { "$ref": "#/$defs/artifact" },
        "output_v7_target_schema": { "$ref": "#/$defs/artifact" },
        "workspace_hook_v1_schema": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    },
    "plantcore_capabilities": {
      "type": "object",
      "required": [
        "supported_operating_systems",
        "resident_bootstrap", "resident_server", "input", "input_operations",
        "immutable_agent_instructions", "controls", "external_mcp_postures",
        "external_mcp_transport", "budget_limits", "usage",
        "typed_usage_per_dispatched_logical_turn", "usage_unavailable",
        "typed_product_result", "product_result_statuses", "product_tools", "workspace",
        "consecutive_tool_error_threshold"
      ],
      "properties": {
        "supported_operating_systems": { "const": ["linux"] },
        "resident_bootstrap": { "const": "plantcore.iteron-run-bootstrap.v1" },
        "resident_server": {
          "type": "object",
          "required": ["command", "transport", "listen"],
          "properties": {
            "command": { "const": "serve" },
            "transport": { "const": "loopback_tcp_jsonl" },
            "listen": { "const": "127.0.0.1:0" }
          },
          "additionalProperties": false
        },
        "input": { "const": ["text", "image", "file"] },
        "input_operations": { "const": ["user_input", "user_input_v2", "user_input_v3"] },
        "immutable_agent_instructions": { "const": true },
        "controls": {
          "type": "object",
          "required": ["resume_same_process", "command_idempotency", "commands"],
          "properties": {
            "resume_same_process": { "const": true },
            "command_idempotency": { "const": "plantcore_command_v1" },
            "commands": { "const": ["steer", "interrupt", "drain", "pause_dispatch_after_safe_point", "resume_dispatch"] }
          },
          "additionalProperties": false
        },
        "external_mcp_postures": { "const": ["disabled", "run_gateway"] },
        "external_mcp_transport": { "const": "streamable_http" },
        "budget_limits": { "const": ["max_turns", "max_tokens", "max_usd", "max_wall_secs"] },
        "usage": {
          "type": "object",
          "required": ["statuses", "calculator_contract_version", "unit", "counters"],
          "properties": {
            "statuses": { "const": ["complete", "unavailable"] },
            "calculator_contract_version": { "const": "plantcore.metering.five-class-ceil.v1" },
            "unit": { "const": "USD_MICRO" },
            "counters": { "const": ["input_tokens", "output_tokens", "cache_creation_tokens", "cache_read_tokens", "thinking_tokens"] }
          },
          "additionalProperties": false
        },
        "typed_usage_per_dispatched_logical_turn": { "const": true },
        "usage_unavailable": { "const": true },
        "typed_product_result": { "const": true },
        "product_result_statuses": { "const": ["completed", "needs_input"] },
        "product_tools": { "const": ["request_user_input", "publish_artifact"] },
        "workspace": {
          "type": "object",
          "required": ["postures", "pre_tool_use_hook_contract", "hook_timeout_milliseconds", "protection_scope"],
          "properties": {
            "postures": { "const": ["read_only", "read_write"] },
            "pre_tool_use_hook_contract": { "const": "plantcore.iteron.workspace-hook.v1" },
            "hook_timeout_milliseconds": { "const": 2000 },
            "protection_scope": { "const": "model_visible_tool_paths_only" }
          },
          "additionalProperties": false
        },
        "consecutive_tool_error_threshold": { "const": 5 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "path", "canonical_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "canonical_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
