{
  "title": "ITERON · 受治理的 HARNESS 架构",
  "purpose": "展示 Iteron 如何把 harness 优化留在离线、非权威控制面，并由固定运行时内核独占 effect 准入与证据追加。",
  "caption": "候选提出方案；证据、人类与内核作出决定。",
  "canvas": {"aspect": "16:9 landscape", "background": "近白色技术论文纸面"},
  "style": {
    "medium": "正式系统论文架构图，精确扁平框，细线连接器，充足留白，清晰中文技术字体，无装饰插画",
    "palette": "深蓝文字；紫色候选生产；绿色评估与治理；橙色人工决策；钴蓝运行时；红色拒绝"
  },
  "zones": [
    {"id": "offline", "label": "离线 CHECKPOINT 控制平面", "tone": "green"},
    {"id": "runtime", "label": "在线 ITERON 运行时", "tone": "blue"}
  ],
  "nodes": [
    {"id": "evidence", "label": "只追加证据", "zone": "offline", "kind": "受治理的结果与 lineage"},
    {"id": "candidate_factory", "label": "HARNESS 候选工厂", "zone": "offline", "kind": "搜索、bandit、结构化变异、文本演化、实现选择"},
    {"id": "independent_eval", "label": "独立评估", "zone": "offline", "kind": "留出集质量、成本、延迟、可靠性与不变量检查"},
    {"id": "rejected", "label": "拒绝 / 退役", "zone": "offline", "kind": "失败候选不能前进"},
    {"id": "human_promotion", "label": "人工晋升", "zone": "offline", "kind": "可问责发布决策"},
    {"id": "checkpoint_registry", "label": "不可变 CHECKPOINT 注册表", "zone": "offline", "kind": "带已知良好回滚目标的版本化 policy bundle"},
    {"id": "bundle_resolver", "label": "固定 BUNDLE 解析器", "zone": "runtime", "kind": "运行准入时只读解析身份"},
    {"id": "strategy_slots", "label": "类型化策略槽", "zone": "runtime", "kind": "路由、规划、上下文、记忆、调度、工具、验证、模型路由、协作"},
    {"id": "authority_kernel", "label": "固定权威内核", "zone": "runtime", "kind": "协议、归约器、能力准入、预算、effect broker、记录与重放"},
    {"id": "world_modules", "label": "执行模块", "zone": "runtime", "kind": "模型提供商、文件系统、shell 与 git、沙箱、MCP 与 LSP、垂类适配器"}
  ],
  "edges": [
    {"id": "RA-01", "from": "evidence", "to": "candidate_factory", "label": "受治理结果", "tone": "purple", "style": "solid"},
    {"id": "RA-02", "from": "candidate_factory", "to": "independent_eval", "label": "类型化候选", "tone": "purple", "style": "solid"},
    {"id": "RA-03", "from": "independent_eval", "to": "rejected", "label": "失败", "tone": "red", "style": "solid"},
    {"id": "RA-04", "from": "rejected", "to": "evidence", "label": "失败证据", "tone": "red", "style": "dashed"},
    {"id": "RA-05", "from": "independent_eval", "to": "human_promotion", "label": "具备资格", "tone": "green", "style": "solid"},
    {"id": "RA-06", "from": "human_promotion", "to": "checkpoint_registry", "label": "批准 CHECKPOINT", "tone": "green", "style": "solid"},
    {"id": "RA-07", "from": "checkpoint_registry", "to": "bundle_resolver", "label": "固定或回滚", "tone": "green", "style": "solid"},
    {"id": "RA-08", "from": "bundle_resolver", "to": "strategy_slots", "label": "类型化 POLICY", "tone": "blue", "style": "solid"},
    {"id": "RA-09", "from": "strategy_slots", "to": "authority_kernel", "label": "意图", "tone": "blue", "style": "solid"},
    {"id": "RA-10", "from": "authority_kernel", "to": "world_modules", "label": "已准入 EFFECT", "tone": "blue", "style": "solid"},
    {"id": "RA-11", "from": "world_modules", "to": "authority_kernel", "label": "结果", "tone": "blue", "style": "dashed"},
    {"id": "RA-12", "from": "authority_kernel", "to": "evidence", "label": "追加结果", "tone": "green", "style": "solid"}
  ],
  "forbidden_edges": [
    {"from": "candidate_factory", "to": "bundle_resolver", "reason": "producer 不能激活自己的候选。"},
    {"from": "candidate_factory", "to": "authority_kernel", "reason": "producer 不能授予权威。"},
    {"from": "independent_eval", "to": "checkpoint_registry", "reason": "评估不能绕过可问责的人工晋升。"},
    {"from": "strategy_slots", "to": "world_modules", "reason": "可学习策略不能绕过能力准入与 effect broker。"},
    {"from": "world_modules", "to": "evidence", "reason": "运行时证据必须经固定权威内核提交。"}
  ],
  "layout_notes": [
    "离线区是顶部宽带，运行时区是底部宽带。",
    "主成功路径从左到右；拒绝分支放在独立评估下方。",
    "在线运行时从左到右排列固定 bundle 解析器、类型化策略槽、固定权威内核、执行模块。",
    "RA-10 与 RA-11 使用清楚分开的上下通道，禁止双向箭头。",
    "RA-12 沿最左侧外缘从固定权威内核绕回只追加证据，不得在区域边框终止。",
    "候选工厂与运行时之间放一个红色禁止标记：禁止自我激活。它不是箭头。",
    "图中不得出现模型训练、SFT、DPO、GRPO 或 RL。"
  ],
  "required_text": [
    "ITERON", "受治理的 HARNESS 架构", "候选提出方案；证据、人类与内核作出决定。",
    "离线 CHECKPOINT 控制平面", "在线 ITERON 运行时", "禁止自我激活",
    "只追加证据", "HARNESS 候选工厂", "独立评估", "拒绝 / 退役", "人工晋升",
    "不可变 CHECKPOINT 注册表", "固定 BUNDLE 解析器", "类型化策略槽", "固定权威内核", "执行模块"
  ]
