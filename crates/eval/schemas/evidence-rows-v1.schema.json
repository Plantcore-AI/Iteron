{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iteron.dev/eval/evidence-rows-v1.schema.json",
  "title": "Iteron Evidence Rows v1",
  "description": "Frozen row contract shared by evidence emission, verification, offline tuning, scoreboards, and the experiment lab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_id",
    "provenance",
    "rows",
    "document_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "schema_id": {
      "const": "iteron-eval/evidence-rows/v1"
    },
    "provenance": {
      "enum": [
        "measured",
        "synthetic_fixture"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/evidence_row"
      }
    },
    "document_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    }
  },
  "$defs": {
    "prefixed_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*[!-~])[ -~]+$"
    },
    "evidence_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "run_id",
        "candidate_id",
        "candidate_digest",
        "dataset_digest",
        "task",
        "config",
        "seed",
        "partition",
        "outcome",
        "resolved",
        "elapsed_ms",
        "cost_status",
        "cost_usd"
      ],
      "properties": {
        "row_id": {
          "$ref": "#/$defs/prefixed_sha256"
        },
        "run_id": {
          "$ref": "#/$defs/label"
        },
        "candidate_id": {
          "$ref": "#/$defs/label"
        },
        "candidate_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/prefixed_sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset_digest": {
          "$ref": "#/$defs/prefixed_sha256"
        },
        "task": {
          "$ref": "#/$defs/label"
        },
        "config": {
          "$ref": "#/$defs/label"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "partition": {
          "enum": [
            "train",
            "held_out"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "task_failure",
            "infrastructure_failure",
            "censored"
          ]
        },
        "resolved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "cost_status": {
          "enum": [
            "known",
            "zero",
            "unknown"
          ]
        },
        "cost_usd": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "success"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "resolved": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "task_failure"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "resolved": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "infrastructure_failure",
                  "censored"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "resolved": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cost_status": {
                "const": "known"
              }
            },
            "required": [
              "cost_status"
            ]
          },
          "then": {
            "properties": {
              "cost_usd": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cost_status": {
                "enum": [
                  "zero",
                  "unknown"
                ]
              }
            },
            "required": [
              "cost_status"
            ]
          },
          "then": {
            "properties": {
              "cost_usd": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
